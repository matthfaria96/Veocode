{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veocode",
  "version": "0.1.1",
  "identifier": "com.veocode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veocode",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/veocode-voice"
    ],
    "category": "DeveloperTool",
    "shortDescription": "See and control what your AI coding agents are doing",
    "copyright": "© 2026 Matheus Faria · MIT",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
